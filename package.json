{
    "name": "olo-logger",
    "version": "0.1.1",
    "description": "olo-logger is a loging service that provides a preconfigured logger as well as ready to use methods around common loging cases, to help you hit the ground runing.",
    "keywords": [
        "logger",
        "loging",
        "utility"
    ],
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/seb-luk/olo-logger.git"
    },
    "bugs": {
        "url": "https://github.com/seb-luk/olo-logger/issues"
    },
    "author": "Sebastian Luksic <sebastian.luksic@me.com>",
    "files": [
        "package.json",
        "README.md",
        "LICENSE",
        "src/**/*.ts",
        "dist/**/*.js",
        "dist/**/*.js.map",
        "dist/**/*.d.ts",
        "dist/**/*.d.ts.map",
        "!src/**/*spec.ts",
        "!dist/test/",
        "!dist/**/*spec.js",
        "!dist/**/*spec.js.map",
        "!dist/**/*spec.d.ts",
        "!dist/**/*spec.d.ts.map"
    ],
    "exports": {
        ".": "./dist/index.js"
    },
    "scripts": {
        "test": "vitest --coverage",
        "build": "shx rm -rf ./dist/* && shx rm -rf doc/ && tsc && typedoc --options typedoc.json"
    },
    "devDependencies": {
        "@types/bunyan": "^1.8.11",
        "@types/koa": "^2.15.0",
        "@types/node": "^22.15.2",
        "@vitest/coverage-v8": "^3.1.2",
        "add": "^2.0.6",
        "shx": "^0.4.0",
        "typedoc": "^0.28.3",
        "typescript": "^5.8.3",
        "vite": "^6.3.3",
        "vitest": "^3.1.2"
    },
    "dependencies": {
        "bunyan": "^1.8.15",
        "dotenv": "^16.5.0",
        "koa": "^3.0.0",
        "olo-platform": "^0.1.2"
    }
}
